/*eslint-disable*/
{{>license-info}}
import {
    Body,
    Controller,
    Delete,
    Get,
    Headers,
    HttpStatus,
    Param,
    Patch,
    Post,
    Put,
    Query,
    Request,
    Response,
    UseInterceptors,
    UploadedFile, 
    UploadedFiles,
} from '@nestjs/common';
import { FileInterceptor, FilesInterceptor } from '@nestjs/platform-express';
import accepts from 'accepts';

import { ApiValidationPipe } from '../api.validation.pipe';
{{#hasAuthMethods}}
import { {{#authMethods}}{{#lambda.pascalcase}}{{name}}{{/lambda.pascalcase}}{{^-last}}, {{/-last}}{{/authMethods}} } from '../../auth/auth.decorator';
{{/hasAuthMethods}}
{{#imports}}
import { {{ classname }}, {{ classname }}Schema } from '{{ filename }}';
{{/imports}}
import { {{ classname }}Api } from './{{ apiFilename }}-api';
import * as {{ classname }}Types from './{{ apiFilename }}-api.types';

/**
 * NOTE: Controllers do not currently support XML as a request content-type
 * To support this consider adding custom middleware,
 * e.g. https://stackoverflow.com/questions/63994341/nestjs-accepting-multiple-mime-types-in-request-body
 */

@Controller()
export class {{ classname }}ApiController {

    constructor(private _{{#lambda.camelcase}}{{ classname }}Api{{/lambda.camelcase}}: {{ classname }}Api) {}

    {{#operations}}
    {{#operation}}
    /**
    {{#description}}
     * {{{.}}}
    {{/description}}
    {{#notes}}
     * {{{.}}}
    {{/notes}}
     */
    @{{#lambda.titlecase}}{{httpMethod}}{{/lambda.titlecase}}('{{path}}')
    {{#authMethods}}
    @{{#lambda.pascalcase}}{{name}}{{/lambda.pascalcase}}({{#isOAuth}}{{#scopes}}'{{{scope}}}'{{^-last}}, {{/-last}}{{/scopes}}{{/isOAuth}})
    {{/authMethods}}
    {{#hasFormParams}}
    {{#formParams}}
    {{#isFile}}
    {{#isArray}}
    @UseInterceptors(FilesInterceptor('{{paramName}}'))
    {{/isArray}}
    {{^isArray}}
    @UseInterceptors(FileInterceptor('{{paramName}}'))
    {{/isArray}}
    {{/isFile}}
    {{/formParams}}
    {{/hasFormParams}}
    async {{operationId}}(
    {{#hasBodyParam}}
    {{#bodyParams.0}}
        @Body(new ApiValidationPipe({{{dataType}}}Schema)) body: {{{dataType}}},
    {{/bodyParams.0}}
    {{/hasBodyParam}}
    {{#hasFormParams}}
    {{#vendorExtensions.x-has-non-file-form-params}}
        @Body(new ApiValidationPipe({{ classname }}Types.{{ operationIdCamelCase }}FormParamsSchema)) formParams: {{ classname }}Types.{{ operationIdCamelCase }}FormParams,
    {{/vendorExtensions.x-has-non-file-form-params}}
    {{#formParams}}
    {{#isFile}}
    {{#isArray}}
        @UploadedFiles() {{paramName}}: Express.Multer.File[],
    {{/isArray}}
    {{^isArray}}
        @UploadedFile() {{paramName}}: Express.Multer.File,
    {{/isArray}}
    {{/isFile}}
    {{/formParams}}
    {{/hasFormParams}}
    {{#hasHeaderParams}}
        // NOTE: Header validation does not currently work with NestJS pipes. Headers type/schema are exported from the types file for optional manual use.
        @Headers() headers: {{ classname }}Types.{{ operationIdCamelCase }}Headers,
    {{/hasHeaderParams}}
    {{#hasQueryParams}}
        @Query(new ApiValidationPipe({{ classname }}Types.{{ operationIdCamelCase }}QueryParamsSchema)) queryParams: {{ classname }}Types.{{ operationIdCamelCase }}QueryParams,
    {{/hasQueryParams}}
    {{#hasPathParams}}
        @Param(new ApiValidationPipe({{ classname }}Types.{{ operationIdCamelCase }}PathParamsSchema)) pathParams: {{ classname }}Types.{{ operationIdCamelCase }}PathParams,
    {{/hasPathParams}}
        @Request() request: any,
        @Response({ passthrough: true }) response: any
    ) {
        {{#hasProduces}}
        // Pull the correct content type from the 'Accepts' header
        const contentType = accepts(request)?.type({{#produces}}'{{{mediaType}}}'{{^-last}}, {{/-last}}{{/produces}});
        if (!contentType) {
            response.status(HttpStatus.NOT_ACCEPTABLE);
            return;
        }
        response.type(contentType);
        {{/hasProduces}}

        // TODO -- loop through responses and set header(s) here??, (hasResponseHeaders)
        {{#hasBodyParam}}
        const payload = body;
        {{/hasBodyParam}}
        {{#hasFormParams}}
        const payload = {
            {{#vendorExtensions.x-has-non-file-form-params}}
            ...formParams,
            {{/vendorExtensions.x-has-non-file-form-params}}
            {{#formParams}}
            {{#isFile}}
            {{paramName}},
            {{/isFile}}
            {{/formParams}}
        };
        {{/hasFormParams}}
        {{^hasBodyParam}}
        {{^hasFormParams}}
        const payload = undefined;
        {{/hasFormParams}}
        {{/hasBodyParam}}

        return await this._{{#lambda.camelcase}}{{ classname }}Api{{/lambda.camelcase}}.{{operationId}}({
            payload,
            headers{{^hasHeaderParams}}: undefined{{/hasHeaderParams}},
            queryParams{{^hasQueryParams}}: undefined{{/hasQueryParams}},
            pathParams{{^hasPathParams}}: undefined{{/hasPathParams}},
            request,
            response,
        });
    }

    {{/operation}}
    {{/operations}}
    /** If we have multipart/form-data AND files, need multer: https://docs.nestjs.com/techniques/file-upload. Files are BINARY format strings */
}
